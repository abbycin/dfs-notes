---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "./Layout.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { type Locale } from "@/i18n/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  /** 当前页在各语言下的地址（仅已有翻译），供 head hreflang 与语言切换器 */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  alternates,
  noindex,
} = Astro.props;

const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? t.site.title,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};

// 面包屑：首页 > 文章列表 > 本文
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t.site.title,
      item: new URL(getRelativeLocaleUrl(locale, ""), Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Posts",
      item: new URL(getRelativeLocaleUrl(locale, "posts"), Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: new URL(Astro.url.pathname, Astro.site).href,
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL} {alternates} {noindex}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbData).replace(/</g, "\\u003c")}
    />
  </Fragment>

  <slot />
</Layout>
