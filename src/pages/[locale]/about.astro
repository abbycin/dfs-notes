---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import { locales } from "@/i18n/config";

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const locale = Astro.currentLocale ?? undefined;
const t = useTranslations(locale);

// 关于页内容按 `<name>.<locale>.md` 配对，见 content.config.ts
const about = await getEntry("pages", `about.${locale ?? "zh"}`);

if (!about) {
  throw new Error(
    "Missing content entry: `about.zh.md` / `about.en.md` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${t.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
