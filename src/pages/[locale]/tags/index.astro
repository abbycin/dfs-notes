---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { splitId } from "@/utils/postLocale";
import { useTranslations } from "@/i18n";
import { locales } from "@/i18n/config";
import config from "@/config";

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const locale = Astro.currentLocale ?? config.site.lang;

// 标签只统计当前语言的非草稿、非 unlisted 文章
const posts = await getCollection(
  "posts",
  ({ id, data }) =>
    splitId(id).locale === locale && !data.draft && !data.unlisted
);
const tags = getUniqueTags(posts);

const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${t.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
