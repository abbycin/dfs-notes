---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { splitId } from "@/utils/postLocale";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations, type Locale } from "@/i18n";
import { locales } from "@/i18n/config";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const paths = [];

  for (const locale of locales) {
    // 每个语言单独统计标签；unlisted 不参与
    const posts = await getCollection(
      "posts",
      ({ id, data }) =>
        splitId(id).locale === locale && !data.draft && !data.unlisted
    );
    const tags = getUniqueTags(posts);

    for (const { tag, tagName } of tags) {
      const tagPosts = getSortedPosts(
        posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
      );

      paths.push(
        ...paginate(tagPosts, {
          params: { locale, tag },
          props: { tagName },
          pageSize: config.posts.perPage,
        })
      );
    }
  }

  return paths;
}

const { page, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// 该标签在其他语言下确有文章时才提供 alternate，避免 hreflang 指向 404
const tagSlug = Astro.params.tag as string;
const alternates: Partial<Record<Locale, string>> = {
  [locale as Locale]: Astro.url.pathname,
};
for (const target of locales) {
  if (target === locale) continue;
  const targetPosts = await getCollection(
    "posts",
    ({ id, data }) =>
      splitId(id).locale === target && !data.draft && !data.unlisted
  );
  const targetTags = getUniqueTags(targetPosts);
  if (targetTags.some(({ tag }) => tag === tagSlug)) {
    alternates[target] = getRelativeLocaleUrl(target, `tags/${tagSlug}/`);
  }
}
---

<Layout title={`${t.pages.tagTitle}: ${tagName} | ${t.site.title}`} {alternates}>
  <Header {alternates} />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  >
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
